# Example only — do not put secrets here

# Neon / Postgres connection string (required)
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Secret used to sign session cookies (required — use a long random string in production)
SESSION_SECRET=change-me-to-a-long-random-string

# Port the server listens on (optional — defaults to 3000)
PORT=3000

# Set to "production" to enable production-mode guards (e.g. refuses to start with
# the default SESSION_SECRET).  Set in your Render (or other host) environment.
NODE_ENV=production

# ── Discourse integration ─────────────────────────────────────────────────────
# NOTE: Discourse credentials (API key, API username, base URL, SSO secret) are
# stored encrypted in the app_config database table and managed via the Admin
# Panel UI.  Do NOT set them here — they will not be read from environment.
#
# The only Discourse-related env vars read by the server are:

# Enable DiscourseConnect SSO endpoints (set to "true" to activate).
# When enabled, users can log in via the Discourse forum at /api/discourse/sso.
# DISCOURSE_SSO_ENABLED=true

# Optional: 64-char hex AES-256 key for encrypting stored Discourse credentials.
# Defaults to a key derived from SESSION_SECRET.  Change only if you need to
# rotate the encryption key independently of the session secret.
# DISCOURSE_ENCRYPTION_KEY=

# ── Email (SendGrid) ─────────────────────────────────────────────────────────
# Required for sending email verification messages via SendGrid.
# SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxx
# SENDGRID_FROM=support@rulebritannia.org

# Base URL used to build verification links in emails (no trailing slash).
# Defaults to https://www.rulebritannia.org if not set.
# APP_BASE_URL=https://www.rulebritannia.org

# ── Cloudflare Turnstile (anti-bot) ──────────────────────────────────────────
# Set TURNSTILE_ENABLED=true to activate the Turnstile widget on registration.
# TURNSTILE_SITE_KEY is public and safe to expose to the frontend.
# TURNSTILE_SECRET_KEY must be kept secret — never commit it.
# TURNSTILE_ENABLED=true
# TURNSTILE_SITE_KEY=0x4AAAAAAA...
# TURNSTILE_SECRET_KEY=0x4AAAAAAA...
