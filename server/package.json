{
  "name": "rulebritannia-server",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "index.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node index.js",
    "check:static": "node --check index.js",
    "test": "node --test *.test.js",
    "test:unit": "node ./scripts/run-unit-tests.mjs",
    "test:integration": "NODE_ENV=test node --test parliamentary.integration.test.js",
    "test:integration:all": "NODE_ENV=test node ./scripts/require-test-db.mjs && NODE_ENV=test node ./scripts/run-integration-tests.mjs",
    "verify:alpha": "npm run check:static && npm run test:unit && npm run test:integration:all"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "connect-pg-simple": "^10.0.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.2.1",
    "express-session": "^1.17.3",
    "@sendgrid/mail": "^8.1.4",
    "pg": "^8.12.0"
  }
}
